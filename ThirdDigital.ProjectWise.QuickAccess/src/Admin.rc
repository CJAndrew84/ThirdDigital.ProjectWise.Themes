#include <windows.h>
#include "AdminResources.h"

IDD_NEW_USER DIALOGEX 0, 0, 390, 322
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New datasource user"
FONT 11, "Segoe UI"
BEGIN
    LTEXT "Datasource", -1, 12, 12, 92, 14
    LTEXT "", IDC_USER_DATASOURCE, 110, 12, 268, 23
    LTEXT "Account &type", -1, 12, 42, 92, 14
    COMBOBOX IDC_USER_TYPE, 110, 39, 268, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Name", -1, 12, 65, 92, 14
    EDITTEXT IDC_USER_NAME, 110, 62, 268, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Description", -1, 12, 88, 92, 14
    EDITTEXT IDC_USER_DESCRIPTION, 110, 85, 268, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Identity &email", IDC_USER_EMAIL_LABEL, 12, 111, 92, 14
    EDITTEXT IDC_USER_EMAIL, 110, 108, 268, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Password", IDC_USER_PASSWORD_LABEL, 12, 134, 92, 14
    EDITTEXT IDC_USER_PASSWORD, 110, 131, 268, 18, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Repeat password", IDC_USER_CONFIRMATION_LABEL, 12, 157, 92, 14
    EDITTEXT IDC_USER_CONFIRMATION, 110, 154, 268, 18, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_USER_HINT, 12, 180, 366, 32
    LTEXT "ProjectWise response (select text to copy)", IDC_USER_STATUS_LABEL, 12, 218, 366, 14
    EDITTEXT IDC_USER_STATUS, 12, 234, 366, 48, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "&Create account", IDOK, 219, 293, 88, 20, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 314, 293, 64, 20, WS_TABSTOP
END
