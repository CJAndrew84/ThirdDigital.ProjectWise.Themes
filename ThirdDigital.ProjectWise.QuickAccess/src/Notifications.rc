#include <windows.h>
#include "NotificationResources.h"
IDD_WORKFLOW_NOTIFY DIALOGEX 0, 0, 460, 348
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Notify about workflow changes"
FONT 11, "Segoe UI"
BEGIN
    LTEXT "", IDC_NOTIFY_SUMMARY, 12, 10, 436, 24
    LTEXT "Open links in", -1, 12, 35, 70, 12
    COMBOBOX IDC_NOTIFY_LINK_APP, 88, 32, 230, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LISTBOX IDC_NOTIFY_ITEMS, 12, 58, 436, 38, LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Remove selected", IDC_NOTIFY_REMOVE, 12, 100, 92, 18, WS_TABSTOP
    PUSHBUTTON "Clear all", IDC_NOTIFY_CLEAR, 112, 100, 68, 18, WS_TABSTOP
    CONTROL "Teams message", IDC_NOTIFY_TEAMS, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 210, 100, 108, 18
    CONTROL "Email", IDC_NOTIFY_EMAIL, "Button", BS_AUTORADIOBUTTON, 340, 100, 90, 18
    LTEXT "Recipients (Teams sign-in addresses / UPNs; separate with semicolons)", IDC_NOTIFY_TO_LABEL, 12, 124, 436, 14
    EDITTEXT IDC_NOTIFY_RECIPIENTS, 12, 141, 436, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Additional message (optional)", -1, 12, 168, 436, 12
    EDITTEXT IDC_NOTIFY_NOTE, 12, 183, 436, 24, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Workflow changes and HTTPS links", -1, 12, 212, 436, 12
    EDITTEXT IDC_NOTIFY_MESSAGE, 12, 226, 436, 53, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Opens a draft. Review recipients and press Send in Teams or your email app.", IDC_NOTIFY_STATUS, 12, 284, 436, 26
    PUSHBUTTON "Add to basket", IDC_NOTIFY_PARK, 12, 317, 98, 21, WS_TABSTOP
    PUSHBUTTON "Copy message", IDC_NOTIFY_COPY, 119, 317, 90, 21, WS_TABSTOP
    DEFPUSHBUTTON "Not now", IDCANCEL, 270, 317, 76, 21, WS_TABSTOP
    PUSHBUTTON "Open Teams", IDC_NOTIFY_OPEN, 355, 317, 93, 21, WS_TABSTOP
END
