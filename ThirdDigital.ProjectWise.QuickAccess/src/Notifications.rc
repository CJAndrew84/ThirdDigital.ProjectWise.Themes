#include <windows.h>
#include "NotificationResources.h"
IDD_WORKFLOW_NOTIFY DIALOGEX 0, 0, 460, 318
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Notify about workflow changes"
FONT 11, "Segoe UI"
BEGIN
    LTEXT "", IDC_NOTIFY_SUMMARY, 12, 12, 436, 28
    CONTROL "Teams message", IDC_NOTIFY_TEAMS, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 12, 46, 115, 18
    CONTROL "Email", IDC_NOTIFY_EMAIL, "Button", BS_AUTORADIOBUTTON, 140, 46, 90, 18
    LTEXT "Recipients (Teams sign-in addresses / UPNs; separate with semicolons)", IDC_NOTIFY_TO_LABEL, 12, 71, 436, 14
    EDITTEXT IDC_NOTIFY_RECIPIENTS, 12, 89, 436, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Message (review and edit before opening the app)", -1, 12, 118, 436, 14
    EDITTEXT IDC_NOTIFY_MESSAGE, 12, 135, 436, 110, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Opens a draft. Review recipients and press Send in Teams or your email app.", IDC_NOTIFY_STATUS, 12, 251, 436, 30
    PUSHBUTTON "Copy message", IDC_NOTIFY_COPY, 12, 287, 90, 21, WS_TABSTOP
    DEFPUSHBUTTON "Not now", IDCANCEL, 270, 287, 76, 21, WS_TABSTOP
    PUSHBUTTON "Open Teams", IDC_NOTIFY_OPEN, 355, 287, 93, 21, WS_TABSTOP
END
