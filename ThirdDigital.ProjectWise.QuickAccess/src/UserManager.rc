#include <windows.h>
#include <commctrl.h>
#include "UserManagerResources.h"

IDD_USER_MANAGER DIALOGEX 0, 0, 620, 290
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Project user management"
FONT 11, "Segoe UI"
BEGIN
    LTEXT "", IDC_MANAGER_SCOPE, 8, 6, 600, 18
    LTEXT "Projects and userlists", IDC_MANAGER_PROJECT_LABEL, 8, 26, 170, 14
    CONTROL "", IDC_MANAGER_TREE, WC_TREEVIEW, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 8, 42, 170, 180
    LTEXT "&Find user (name or email)", IDC_MANAGER_SEARCH_LABEL, 188, 26, 160, 14
    EDITTEXT IDC_MANAGER_SEARCH, 350, 24, 260, 18, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_MANAGER_GRID, WC_LISTVIEW, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 188, 48, 422, 90
    LTEXT "Direct memberships for selected user", IDC_MANAGER_MEMBER_LABEL, 188, 142, 200, 14
    CONTROL "", IDC_MANAGER_MEMBERS, WC_LISTVIEW, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 188, 158, 200, 64
    LTEXT "Pending changes (review before Apply)", IDC_MANAGER_PENDING_LABEL, 398, 142, 212, 14
    CONTROL "", IDC_MANAGER_PENDING, WC_LISTVIEW, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 398, 158, 212, 64
    LTEXT "No template user selected", IDC_MANAGER_TEMPLATE_LABEL, 8, 226, 600, 14
    PUSHBUTTON "&Refresh", IDC_MANAGER_REFRESH, 8, 244, 68, 20, WS_TABSTOP
    PUSHBUTTON "Use as &template", IDC_MANAGER_TEMPLATE, 80, 244, 84, 20, WS_TABSTOP
    PUSHBUTTON "&Copy memberships", IDC_MANAGER_COPY, 168, 244, 90, 20, WS_TABSTOP
    PUSHBUTTON "&New user...", IDC_MANAGER_NEW, 262, 244, 68, 20, WS_TABSTOP
    PUSHBUTTON "&Apply changes", IDC_MANAGER_APPLY, 334, 244, 80, 20, WS_TABSTOP
    PUSHBUTTON "&Discard changes", IDC_MANAGER_DISCARD, 418, 244, 90, 20, WS_TABSTOP
    PUSHBUTTON "Close", IDC_MANAGER_CLOSE, 512, 244, 68, 20, WS_TABSTOP
    EDITTEXT IDC_MANAGER_STATUS, 8, 268, 602, 18, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END
