	<Error Condition="'$(PWSDKDir)' == ''" Text="PWSDKDir is not set. Point it at the ProjectWise SDK root." />
	<Error Condition="!Exists('$(PWSDKDir)\include\aawindms.h') or !Exists('$(PWSDKDir)\include\aaapi.h') or !Exists('$(PWSDKDir)\include\aadmsapi.h') or !Exists('$(PWSDKDir)\lib\Win32\dmawin.lib') or !Exists('$(PWSDKDir)\lib\Win32\dmscli.lib') or !Exists('$(PWSDKDir)\lib\Win32\dmsgen.lib')" Text="The ProjectWise SDK must contain include\aawindms.h, include\aadmsapi.h, include\aaapi.h and the Win32 dmawin.lib/dmscli.lib/dmsgen.lib libraries. Explorer 23.06 uses an x86 module." />
  </Target>
