	  <AdditionalIncludeDirectories>$(PWSDKDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
	</ClCompile>
	<Link>
	  <SubSystem>Windows</SubSystem>
	  <ModuleDefinitionFile>src\QuickAccess.def</ModuleDefinitionFile>
	  <AdditionalDependencies>comctl32.lib;shell32.lib;dmawin.lib;dmscli.lib;dmsgen.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
	  <AdditionalLibraryDirectories>$(PWSDKDir)\lib\Win32;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
